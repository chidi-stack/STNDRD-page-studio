# Copy to `.env.local`. Never commit `.env.local`.
# Use names without NEXT_PUBLIC_ — these stay server-only (except site URL fallback below).

SITE_URL=http://localhost:3000

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=page-studio-assets

# Optional: only if you add browser Supabase later
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
